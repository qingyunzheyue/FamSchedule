# FamSchedule — Supabase Project 1 credentials
# 复制本文件为 .env 并填入实际值。
# 注意:.env 已被 .gitignore 排除,不要提交到 git。

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...                 # 客户端 SDK 用(Expo public 变量)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...         # 后端脚本 / verify 用,绕过 RLS

# Supabase Dashboard → Project Settings → General → Project ID
SUPABASE_PROJECT_REF=xxxxx

# Supabase Dashboard → Account → Access Tokens(用于 supabase CLI 登录)
# 留空表示不走 CLI 路径
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx

# Supabase Dashboard → Project Settings → Database → Connection string → Direct
# 仅当走 psql / node-pg 直连时需要
SUPABASE_DB_PASSWORD=xxxxxxxx
